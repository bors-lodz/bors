---
import { site, nav } from '../config/site';
const year = new Date().getFullYear();
const phoneShort = site.phone.replace('+48', '').trim();
---
<!-- FOOTER -->
<footer class="foot-space" style="background:#17262a;color:#e9e2d6;padding:5rem 0 2rem;font-size:0.95rem;">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div style="display:flex;align-items:center;gap:0.8rem;margin-bottom:1.2rem;">
          <svg width="40" height="40" viewBox="0 0 44 44" aria-hidden="true"><rect x="0" y="0" width="44" height="44" fill="#3a4a4d"></rect><rect x="3" y="3" width="17.5" height="17.5" fill="#f3ede3"></rect><rect x="23.5" y="3" width="17.5" height="17.5" fill="#c86a35"></rect><rect x="3" y="23.5" width="17.5" height="17.5" fill="#f3ede3"></rect><rect x="23.5" y="23.5" width="17.5" height="17.5" fill="#f3ede3"></rect></svg>
          <span class="disp" style="font-size:1.7rem;font-weight:800;letter-spacing:0.02em;color:#f3ede3;">BORS</span>
        </div>
        <p style="margin:0;color:#c2c9c7;max-width:22rem;">{site.legalName}. Instalacje i remonty w Łodzi i okolicy, na rynku od {site.foundedYear} roku.</p>
        <p class="mono" style="font-size:0.74rem;color:#e8a27a;margin:1.4rem 0 0.4rem;">Dane firmy</p>
        <p style="margin:0;color:#c2c9c7;">NIP: {site.nip}<br />REGON: {site.regon}</p>
      </div>
      <div>
        <p class="mono" style="font-size:0.74rem;color:#e8a27a;margin:0 0 0.9rem;">Kontakt</p>
        <p style="margin:0;"><a href={`tel:${site.phoneHref}`} style="text-decoration:none;font-weight:600;color:#f3ede3;">{site.phone}</a><br /><a href="/kontakt">Formularz kontaktowy</a></p>
        <p class="mono" style="font-size:0.74rem;color:#e8a27a;margin:1.4rem 0 0.5rem;">Godziny</p>
        <p style="margin:0;">pon.-pt. 9:00-17:00</p>
      </div>
      <div>
        <p class="mono" style="font-size:0.74rem;color:#e8a27a;margin:0 0 0.9rem;">Obszar</p>
        <nav aria-label="Obszar w stopce" style="display:flex;flex-direction:column;gap:0.45rem;color:#c2c9c7;">
          {site.areaServed.map((c) => <span>{c}</span>)}
        </nav>
      </div>
      <div>
        <p class="mono" style="font-size:0.74rem;color:#e8a27a;margin:0 0 0.9rem;">Strona</p>
        <nav aria-label="Stopka" style="display:flex;flex-direction:column;gap:0.45rem;">
          {nav.map((item) => <a href={item.href} style="text-decoration:none;">{item.label}</a>)}
          <a href="/polityka-prywatnosci" style="text-decoration:none;">Polityka prywatności</a>
        </nav>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;margin-top:4rem;padding-top:1.5rem;border-top:1px solid #3a4a4d;color:#aab4b2;font-size:0.85rem;">
      <span>&copy; {year} {site.brand}. Ceny w kalkulatorze są orientacyjne.</span>
      <span>Realizacja: <a href={site.author.url} target="_blank" rel="noopener" style="color:#e8a27a;font-weight:600;">{site.author.name}</a></span>
    </div>
  </div>
</footer>

<!-- MOBILE STICKY CALL -->
<a class="mcall btn-cu" href={`tel:${site.phoneHref}`} style="align-items:center;justify-content:center;gap:0.7rem;background:#a8521f;color:#ffffff;text-decoration:none;font-weight:600;font-size:1.1rem;padding:1rem 1.2rem;box-shadow:0 10px 30px -10px rgba(23,38,42,.6);">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
  Zadzwoń: {phoneShort}
</a>
