---
import { site, nav } from '../config/site';
const phoneShort = site.phone.replace('+48', '').trim();
---
<!-- TOP BAR -->
<div style="background:#17262a;color:#e9e2d6;">
  <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-top:0.55rem;padding-bottom:0.55rem;">
    <span class="mono" style="font-size:0.76rem;display:inline-flex;align-items:center;gap:0.6rem;"><span style="width:0.6rem;height:0.6rem;background:#c86a35;display:inline-block;"></span>Bezpłatne oględziny - Łódź i okolice</span>
    <span class="mono topbar-extra" style="font-size:0.76rem;">pon.-pt. 9:00-17:00 &nbsp;|&nbsp; Na rynku od 1996 roku</span>
  </div>
</div>

<!-- HEADER (sticky) -->
<header style="position:sticky;top:0;z-index:40;background:#f3ede3;border-bottom:1px solid #d6c9b4;">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;padding-top:1.1rem;padding-bottom:1.1rem;">
    <a href="/" aria-label="BORS - strona główna" style="display:flex;align-items:center;gap:0.8rem;text-decoration:none;">
      <svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true"><rect x="0" y="0" width="44" height="44" fill="#d6c9b4"></rect><rect x="3" y="3" width="17.5" height="17.5" fill="#f3ede3"></rect><rect x="23.5" y="3" width="17.5" height="17.5" fill="#a8521f"></rect><rect x="3" y="23.5" width="17.5" height="17.5" fill="#f3ede3"></rect><rect x="23.5" y="23.5" width="17.5" height="17.5" fill="#f3ede3"></rect><rect x="0.5" y="0.5" width="43" height="43" fill="none" stroke="#17262a" stroke-width="1"></rect></svg>
      <span style="display:flex;flex-direction:column;line-height:1;">
        <span class="disp" style="font-size:1.85rem;font-weight:800;letter-spacing:0.02em;">BORS</span>
        <span class="mono" style="font-size:0.62rem;color:#4a5557;margin-top:0.3rem;">Instalacje i remonty</span>
      </span>
    </a>
    <nav class="nav" aria-label="Główna nawigacja" style="display:flex;gap:2.4rem;font-weight:500;font-size:1rem;">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="hdr-phone btn-cu" href={`tel:${site.phoneHref}`} style="display:inline-flex;align-items:center;gap:0.6rem;background:#a8521f;color:#ffffff;text-decoration:none;font-weight:600;padding:0.75rem 1.2rem;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
      {phoneShort}
    </a>
    <details class="mnav" style="position:relative;">
      <summary aria-label="Otwórz menu" style="display:flex;align-items:center;justify-content:center;width:46px;height:46px;border:1.5px solid #17262a;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      </summary>
      <div style="position:absolute;right:0;top:calc(100% + 0.5rem);background:#17262a;color:#f3ede3;min-width:240px;padding:1.2rem;display:flex;flex-direction:column;gap:0.9rem;z-index:10;">
        {nav.map((item) => <a href={item.href} style="text-decoration:none;">{item.label}</a>)}
        <a href={`tel:${site.phoneHref}`} style="text-decoration:none;background:#a8521f;color:#ffffff;padding:0.7rem 1rem;font-weight:600;">Zadzwoń: {phoneShort}</a>
      </div>
    </details>
  </div>
</header>
