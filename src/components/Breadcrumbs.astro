---
import type { Crumb } from '../lib/seo';
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav aria-label="Okruszki" class="mx-auto max-w-6xl px-4 pt-6 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i < items.length - 1 ? (
          <><a href={c.href} class="hover:text-copper">{c.name}</a><span aria-hidden="true">/</span></>
        ) : (
          <span class="font-semibold text-ink" aria-current="page">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
