---
/** Logo BORS - koncepcja B (płytki/glazura). */
interface Props {
  variant?: 'full' | 'mark';
  onDark?: boolean;
  class?: string;
}
const { variant = 'full', onDark = false, class: cls = '' } = Astro.props;

const badge = onDark ? '#F5F3EF' : '#10505C';
const tile = onDark ? '#10505C' : '#F5F3EF';
const accent = onDark ? '#C26B35' : '#C26B35';
const word = onDark ? '#F5F3EF' : '#1C2A2E';
const sub = onDark ? '#D98A4F' : '#C26B35';
---
{variant === 'mark' ? (
  <svg class={cls} viewBox="0 0 64 64" width="40" height="40" role="img" aria-label="BORS">
    <rect x="1" y="1" width="62" height="62" rx="14" fill={badge} />
    <rect x="13" y="13" width="16" height="16" rx="3" fill={tile} />
    <rect x="35" y="13" width="16" height="16" rx="3" fill={tile} />
    <rect x="13" y="35" width="16" height="16" rx="3" fill={tile} />
    <rect x="35" y="35" width="16" height="16" rx="3" fill={accent} />
  </svg>
) : (
  <svg class={cls} viewBox="0 0 334 92" role="img" aria-label="BORS - instalacje i remonty">
    <g transform="translate(8,14)">
      <rect width="64" height="64" rx="14" fill={badge} />
      <rect x="13" y="13" width="16" height="16" rx="3" fill={tile} />
      <rect x="35" y="13" width="16" height="16" rx="3" fill={tile} />
      <rect x="13" y="35" width="16" height="16" rx="3" fill={tile} />
      <rect x="35" y="35" width="16" height="16" rx="3" fill={accent} />
    </g>
    <text x="88" y="51" font-family="Archivo, sans-serif" font-weight="800" font-size="40" letter-spacing="1" fill={word}>BORS</text>
    <text x="90" y="76" font-family="Archivo, sans-serif" font-weight="700" font-size="16" letter-spacing="2.2" fill={sub}>INSTALACJE · REMONTY</text>
  </svg>
)}
