---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Calculator from '../components/Calculator.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbJsonLd } from '../lib/seo';
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Kalkulator', href: '/kalkulator' }];
---
<BaseLayout
  title="Kalkulator remontu i wyceny online - Łódź | BORS"
  description="Oblicz orientacyjny koszt remontu łazienki, instalacji wod-kan i c.o. oraz układania płytek w Łodzi. Szybka, bezpłatna wycena online - widełki cenowe i czas realizacji."
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <section class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="mono mb-3 text-xs font-bold text-copper">02 / Kalkulator online</p>
      <h1 class="text-4xl sm:text-5xl">Kalkulator kosztu remontu</h1>
      <p class="mt-3 text-lg text-muted">Odpowiedz na kilka pytań i zobacz orientacyjne widełki cenowe oraz czas realizacji. Bez logowania.</p>
    </div>

    <Calculator />

    <p class="mx-auto mt-8 flex max-w-3xl items-start gap-2 text-sm text-muted">
      <Icon name="check" size={18} class="mt-0.5 shrink-0 text-copper" />
      Wynik ma charakter orientacyjny i nie stanowi oferty w rozumieniu Kodeksu cywilnego. Ostateczna cena ustalana jest po bezpłatnych oględzinach.
    </p>
  </section>
</BaseLayout>
