---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Kalkulator', href: '/kalkulator' }];
---
<BaseLayout
  title="Kalkulator remontu i wyceny - Łódź | BORS"
  description="Oblicz orientacyjny koszt remontu łazienki, instalacji wod-kan i c.o. oraz układania płytek w Łodzi. Szybka, bezpłatna wycena online."
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="text-3xl sm:text-4xl">Kalkulator wyceny</h1>
    <!-- Interaktywny kreator powstaje w etapie 4 (src/lib/estimate.ts + wyspa). -->
    <p class="mt-4 max-w-2xl text-lg text-muted">Interaktywny kalkulator pojawi się tutaj wkrótce.</p>
  </section>
</BaseLayout>
