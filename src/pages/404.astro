---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { servicesByHome } from '../data/services';
---
<BaseLayout title="Nie znaleziono strony (404) | BORS" description="Strona nie istnieje." noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="font-display text-7xl font-extrabold text-copper">404</p>
    <h1 class="mt-4 text-3xl">Nie znalazłem tej strony</h1>
    <p class="mt-3 text-lg text-muted">Być może adres jest nieaktualny. Wróć na stronę główną lub sprawdź moje usługi.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-copper px-5 py-3 font-bold text-white hover:bg-copper-light">Strona główna</a>
      <a href="/kalkulator" class="inline-flex items-center gap-2 rounded-xl border-2 border-line px-5 py-3 font-bold text-ink hover:border-copper"><Icon name="calc" size={18} /> Kalkulator</a>
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-2">
      {servicesByHome.map((s) => (
        <li><a href={`/uslugi/${s.slug}`} class="rounded-full border border-line px-4 py-1.5 text-sm font-semibold hover:border-copper">{s.navTitle}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
