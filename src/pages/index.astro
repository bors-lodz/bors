---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { faqJsonLd } from '../lib/seo';

const phoneShort = site.phone.replace('+48', '').trim();
const years = new Date().getFullYear() - site.foundedYear;

const faqs = [
  { q: 'Czy oględziny są płatne?', a: 'Nie. Oględziny są bezpłatne - przyjeżdżam, oceniam zakres prac i na tej podstawie przygotowuję wycenę.' },
  { q: 'Ile kosztuje punkt wodno-kanalizacyjny?', a: 'Orientacyjnie od 800 zł netto za punkt. Dokładny koszt zależy od stanu instalacji i zakresu prac, dlatego potwierdzam go po oględzinach.' },
  { q: 'Czy wynik z kalkulatora to ostateczna cena?', a: 'Nie - kalkulator pokazuje orientacyjne widełki z rozbiciem na pozycje i szacowany czas. Wiążącą wycenę przygotowuję po obejrzeniu miejsca.' },
  { q: 'Gdzie wykonujesz prace?', a: 'W Łodzi oraz w Pabianicach, Zgierzu, Aleksandrowie Łódzkim i Konstantynowie Łódzkim.' },
  { q: 'Jak najszybciej się skontaktować?', a: 'Telefonicznie pod numerem 603 378 228, pon.-pt. 9:00-17:00, albo przez formularz - oddzwonię w godzinach pracy.' },
];
---
<BaseLayout
  title="Hydraulik i remonty Łódź - wod-kan, c.o., glazura, łazienki | BORS"
  description="BORS - instalacje wodno-kanalizacyjne, c.o. oraz remonty łazienek i glazura w Łodzi i okolicach. Na rynku od 1996 roku. Bezpłatne oględziny i wycena, kalkulator kosztów online."
  jsonLd={[faqJsonLd(faqs)]}
>
<!-- HERO -->
<section style="padding:4.5rem 0 5rem;">
<div class="wrap hero-grid">
<div>
<p class="mono sec-label" style="color:#a8521f;margin:0 0 2rem;">Hydraulik i glazurnik - Łódź, od 1996</p>
<h1 class="disp" style="font-size:clamp(3rem,6.4vw,6.2rem);line-height:0.95;font-weight:600;margin:0 0 2rem;">Łazienki i&nbsp;instalacje. <em style="font-weight:400;color:#0e4650;">Od rury</em> do <span style="position:relative;white-space:nowrap;">fugi<svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:0;bottom:-0.12em;width:100%;height:0.16em;"><rect x="0" y="4" width="200" height="6" fill="#a8521f"></rect></svg></span>.</h1>
<p style="font-size:1.25rem;max-width:34rem;margin:0 0 2.4rem;color:#3a4749;">Remonty łazienek, instalacje wodno-kanalizacyjne i grzewcze oraz glazura i terakota - w Łodzi i okolicach. Najpierw bezpłatne oględziny, potem przejrzysta wycena z rozbiciem na pozycje - zanim cokolwiek skuję.</p>
<div style="display:flex;flex-wrap:wrap;align-items:center;gap:1.4rem;">
<a class="btn-cu" href={`tel:${site.phoneHref}`} style="display:inline-flex;align-items:center;gap:1rem;background:#a8521f;color:#ffffff;text-decoration:none;padding:1rem 1.8rem 1rem 1rem;">
<span style="display:flex;align-items:center;justify-content:center;width:46px;height:46px;background:#f3ede3;color:#a8521f;">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
</span>
<span style="display:flex;flex-direction:column;line-height:1.15;">
<span class="mono" style="font-size:0.74rem;">Zadzwoń - pon.-pt. 9:00-17:00</span>
<span class="disp" style="font-size:1.9rem;font-weight:700;letter-spacing:0;">{phoneShort}</span>
</span>
</a>
<a class="btn-ink" href="/kalkulator" style="display:inline-flex;align-items:center;gap:0.9rem;border:1.5px solid #17262a;text-decoration:none;padding:1rem 1.4rem;">
<span style="display:flex;flex-direction:column;line-height:1.2;">
<span class="mono" style="font-size:0.72rem;color:#4a5557;">2 minuty, bez logowania</span>
<span style="font-weight:600;">Policz koszt remontu</span>
</span>
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</a>
</div>
<ul style="list-style:none;padding:0;margin:2.2rem 0 0;display:flex;flex-wrap:wrap;gap:0.7rem 1.8rem;font-weight:600;font-size:0.98rem;">
<li style="display:inline-flex;align-items:center;gap:0.6rem;"><span style="width:0.7rem;height:0.7rem;background:#a8521f;flex:none;"></span>Oględziny za 0 zł</li>
<li style="display:inline-flex;align-items:center;gap:0.6rem;"><span style="width:0.7rem;height:0.7rem;background:#a8521f;flex:none;"></span>Wycena pozycja po pozycji</li>
<li style="display:inline-flex;align-items:center;gap:0.6rem;"><span style="width:0.7rem;height:0.7rem;background:#a8521f;flex:none;"></span>Na rynku od 1996</li>
</ul>
</div>

<!-- Tile wall with opened installation -->
<div class="wall" data-parallax="0.05">
<div style="background:#d6c9b4;padding:7px;border:1px solid #9c8c74;">
<svg viewBox="0 0 600 600" role="img" aria-label="Ilustracja: ściana z płytkami, w odkrytym fragmencie widać instalację - pion wody zimnej i ciepłej, zawory odcinające oraz odpływ" style="display:block;width:100%;height:auto;">
<defs>
<pattern id="bmTile" width="75" height="75" patternUnits="userSpaceOnUse"><rect width="75" height="75" fill="#d6c9b4"></rect><rect x="2.5" y="2.5" width="70" height="70" fill="#f3ede3"></rect></pattern>
<pattern id="bmHatch" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="12" height="12" fill="#e6dccb"></rect><line x1="0" y1="0" x2="0" y2="12" stroke="#d6c9b4" stroke-width="2"></line></pattern>
</defs>
<rect width="600" height="600" fill="url(#bmTile)"></rect>
<rect x="377.5" y="77.5" width="70" height="70" fill="#e3d6c2"></rect>
<rect x="2.5" y="527.5" width="70" height="70" fill="#e3d6c2"></rect>
<rect x="527.5" y="227.5" width="70" height="70" fill="#e3d6c2"></rect>
<rect x="527.5" y="452.5" width="70" height="70" fill="#0e4650"></rect>
<rect class="tile-drop" x="452.5" y="2.5" width="70" height="70" fill="#a8521f"></rect>
<rect x="75" y="150" width="300" height="375" fill="url(#bmHatch)"></rect>
<rect x="75" y="150" width="300" height="375" fill="none" stroke="#9c8c74" stroke-width="1.5"></rect>
<path d="M120 525 V215 Q120 195 140 195 H300" fill="none" stroke="#0e4650" stroke-width="8" stroke-linecap="round"></path>
<path d="M155 525 V250 Q155 230 175 230 H300" fill="none" stroke="#a8521f" stroke-width="8" stroke-linecap="round"></path>
<path class="flow" d="M155 525 V250 Q155 230 175 230 H300" fill="none" stroke="#f3ede3" stroke-width="2"></path>
<rect x="298" y="188" width="16" height="14" fill="#17262a"></rect>
<rect x="298" y="223" width="16" height="14" fill="#17262a"></rect>
<g fill="#f3ede3" stroke="#17262a" stroke-width="2" stroke-linejoin="round">
<path d="M212 185 L232 205 V185 L212 205 Z"></path>
<path d="M212 220 L232 240 V220 L212 240 Z"></path>
</g>
<path d="M270 525 V430 Q270 400 300 400 H345" fill="none" stroke="#4a5557" stroke-width="16"></path>
<path d="M270 525 V430 Q270 400 300 400 H345" fill="none" stroke="#e6dccb" stroke-width="9"></path>
<g stroke="#4a5557" stroke-width="1.2">
<line x1="75" y1="118" x2="75" y2="140"></line>
<line x1="375" y1="118" x2="375" y2="140"></line>
<line x1="75" y1="129" x2="375" y2="129"></line>
</g>
<path d="M75 129 l10 -4 v8 z M375 129 l-10 -4 v8 z" fill="#4a5557"></path>
<rect x="199" y="120" width="52" height="18" fill="#f3ede3"></rect>
<text x="225" y="134" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="13" fill="#17262a">1200</text>
<g stroke="#4a5557" stroke-width="1.2">
<line x1="28" y1="150" x2="50" y2="150"></line>
<line x1="28" y1="525" x2="50" y2="525"></line>
<line x1="39" y1="150" x2="39" y2="525"></line>
</g>
<path d="M39 150 l-4 10 h8 z M39 525 l-4 -10 h8 z" fill="#4a5557"></path>
<rect x="30" y="311" width="18" height="52" fill="#f3ede3"></rect>
<text x="44" y="337" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="13" fill="#17262a" transform="rotate(-90 44 337)">1500</text>
<g stroke="#a8521f" stroke-width="1.5">
<line x1="234" y1="213" x2="424" y2="213"></line>
<line x1="160" y1="330" x2="424" y2="330"></line>
<line x1="345" y1="404" x2="426" y2="440"></line>
</g>
<g font-family="JetBrains Mono, monospace" font-size="15" font-weight="700" text-anchor="middle">
<circle cx="440" cy="213" r="15" fill="#f3ede3" stroke="#a8521f" stroke-width="2"></circle>
<text x="440" y="218" fill="#a8521f">1</text>
<circle cx="440" cy="330" r="15" fill="#f3ede3" stroke="#a8521f" stroke-width="2"></circle>
<text x="440" y="335" fill="#a8521f">2</text>
<circle cx="440" cy="446" r="15" fill="#f3ede3" stroke="#a8521f" stroke-width="2"></circle>
<text x="440" y="451" fill="#a8521f">3</text>
</g>
</svg>
</div>
<ol class="mono" style="list-style:none;margin:0.9rem 0 0;padding:0;display:flex;flex-wrap:wrap;gap:0.4rem 1.6rem;font-size:0.74rem;color:#4a5557;">
<li><span style="color:#a8521f;font-weight:700;">1</span> Zawory odcinające</li>
<li><span style="color:#a8521f;font-weight:700;">2</span> Piony wody zimnej i ciepłej</li>
<li><span style="color:#a8521f;font-weight:700;">3</span> Odpływ</li>
<li>Rys. poglądowy</li>
</ol>
<div class="tag" style="background:#0e4650;color:#f3ede3;padding:1rem 1.3rem;max-width:16rem;">
<div class="mono" style="font-size:0.7rem;color:#e8a27a;">Stawka orientacyjna</div>
<div class="disp" style="font-size:2.6rem;font-weight:700;line-height:1;margin-top:0.3rem;">od 800 zł</div>
<div class="mono" style="font-size:0.72rem;color:#d5dfdc;margin-top:0.3rem;">netto / punkt wod-kan</div>
</div>
</div>
</div>
</section>

<!-- FACT STRIP -->
<section aria-label="Najważniejsze informacje" style="padding:0 0 1rem;">
<div class="wrap">
<div class="facts" data-reveal-stagger>
<div style="background:#f3ede3;padding:1.6rem 1.8rem;">
<div class="disp" style="font-size:3rem;font-weight:600;line-height:1;">od 1996</div>
<div style="margin-top:0.5rem;color:#3a4749;">ponad {years} lat w instalacjach i remontach</div>
</div>
<div style="background:#f3ede3;padding:1.6rem 1.8rem;">
<div class="disp" style="font-size:3rem;font-weight:600;line-height:1;">0 zł</div>
<div style="margin-top:0.5rem;color:#3a4749;">za oględziny na miejscu</div>
</div>
<div style="background:#f3ede3;padding:1.6rem 1.8rem;">
<div class="disp" style="font-size:3rem;font-weight:600;line-height:1;">5 miast</div>
<div style="margin-top:0.5rem;color:#3a4749;">Łódź, Pabianice, Zgierz, Aleksandrów Ł., Konstantynów Ł.</div>
</div>
<div style="background:#17262a;color:#f3ede3;padding:1.6rem 1.8rem;display:flex;flex-direction:column;justify-content:space-between;gap:0.6rem;">
<span class="mono" style="font-size:0.74rem;color:#e8a27a;">pon.-pt. 9:00-17:00</span>
<a href={`tel:${site.phoneHref}`} class="disp" style="font-size:2.1rem;font-weight:700;text-decoration:none;line-height:1.05;">{phoneShort}</a>
</div>
</div>
</div>
</section>

<!-- SERVICES -->
<section id="uslugi" style="padding:6rem 0 6rem;">
<div class="wrap">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:3rem;">
<div>
<p class="mono sec-label" style="color:#a8521f;margin:0 0 1.4rem;">01 / Usługi</p>
<h2 class="disp" style="font-size:clamp(2.4rem,4.6vw,4.4rem);line-height:1;font-weight:600;margin:0;max-width:16ch;">Cztery zakresy prac. <em style="font-weight:400;color:#0e4650;">Jeden fachowiec.</em></h2>
</div>
<p style="max-width:26rem;margin:0;color:#3a4749;">Od rozprowadzenia rur po ostatnią fugę - bez szukania osobno hydraulika i glazurnika.</p>
</div>

<div class="svc-head mono" aria-hidden="true" style="display:grid;grid-template-columns:5.5rem 1.35fr 1.2fr 3.5rem;gap:2rem;padding:0 1.5rem 0.8rem;font-size:0.72rem;color:#4a5557;">
<span>Poz.</span><span>Usługa</span><span>Zakres prac</span><span></span>
</div>
<div style="border-bottom:1px solid #cdbfa8;" data-reveal-stagger>
<a class="svc" href="/uslugi/remonty-lazienek">
<span style="display:flex;flex-direction:column;gap:0.3rem;"><span class="disp svc-num" style="font-size:2.6rem;font-weight:300;color:#a8521f;line-height:1;">01</span><span class="mono svc-code" style="font-size:0.72rem;color:#4a5557;">ŁZ</span></span>
<span><span class="disp" style="display:block;font-size:clamp(1.6rem,2.6vw,2.35rem);font-weight:600;line-height:1.1;">Kompleksowe remonty łazienek</span><span class="mono" style="display:inline-block;margin-top:0.7rem;font-size:0.72rem;background:#17262a;color:#f3ede3;padding:0.25rem 0.55rem;">Kompleksowo</span></span>
<span class="svc-desc" style="color:#4a5557;font-size:1rem;">Demontaż, przeróbki wod-kan, hydroizolacja, płytki, biały montaż. Sam prowadzę od pierwszego skucia do odbioru.</span>
<span class="svc-arrow" style="display:flex;align-items:center;justify-content:center;width:3.5rem;height:3.5rem;border:1.5px solid currentColor;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</a>
<a class="svc" href="/uslugi/instalacje-wodno-kanalizacyjne">
<span style="display:flex;flex-direction:column;gap:0.3rem;"><span class="disp svc-num" style="font-size:2.6rem;font-weight:300;color:#a8521f;line-height:1;">02</span><span class="mono svc-code" style="font-size:0.72rem;color:#4a5557;">WK</span></span>
<span><span class="disp" style="display:block;font-size:clamp(1.6rem,2.6vw,2.35rem);font-weight:600;line-height:1.1;">Instalacje wodno-kanalizacyjne</span><span class="mono" style="display:inline-block;margin-top:0.7rem;font-size:0.72rem;background:#a8521f;color:#ffffff;padding:0.25rem 0.55rem;">Punkt od 800 zł netto</span></span>
<span class="svc-desc" style="color:#4a5557;font-size:1rem;">Nowe podejścia, wymiana rur i pionów, przeróbki pod nowy układ łazienki lub kuchni, podłączenia urządzeń.</span>
<span class="svc-arrow" style="display:flex;align-items:center;justify-content:center;width:3.5rem;height:3.5rem;border:1.5px solid currentColor;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</a>
<a class="svc" href="/uslugi/instalacje-grzewcze">
<span style="display:flex;flex-direction:column;gap:0.3rem;"><span class="disp svc-num" style="font-size:2.6rem;font-weight:300;color:#a8521f;line-height:1;">03</span><span class="mono svc-code" style="font-size:0.72rem;color:#4a5557;">CO</span></span>
<span class="disp" style="font-size:clamp(1.6rem,2.6vw,2.35rem);font-weight:600;line-height:1.1;">Instalacje grzewcze (c.o.)</span>
<span class="svc-desc" style="color:#4a5557;font-size:1rem;">Montaż i wymiana grzejników, przeróbki i rozbudowa instalacji centralnego ogrzewania.</span>
<span class="svc-arrow" style="display:flex;align-items:center;justify-content:center;width:3.5rem;height:3.5rem;border:1.5px solid currentColor;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</a>
<a class="svc" href="/uslugi/glazura-terakota">
<span style="display:flex;flex-direction:column;gap:0.3rem;"><span class="disp svc-num" style="font-size:2.6rem;font-weight:300;color:#a8521f;line-height:1;">04</span><span class="mono svc-code" style="font-size:0.72rem;color:#4a5557;">GT</span></span>
<span class="disp" style="font-size:clamp(1.6rem,2.6vw,2.35rem);font-weight:600;line-height:1.1;">Glazura i terakota</span>
<span class="svc-desc" style="color:#4a5557;font-size:1rem;">Układanie płytek na ścianach i podłogach - w łazience i kuchni. Fugowanie, docinki i narożniki.</span>
<span class="svc-arrow" style="display:flex;align-items:center;justify-content:center;width:3.5rem;height:3.5rem;border:1.5px solid currentColor;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</a>
</div>

<!-- not sure band -->
<div style="margin-top:3rem;background:#17262a;color:#f3ede3;padding:2rem 2.2rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem;" data-reveal>
<div style="max-width:40rem;">
<p class="disp" style="margin:0;font-size:clamp(1.5rem,2.4vw,2rem);font-weight:600;line-height:1.15;">Nie wiesz, od czego zacząć?</p>
<p style="margin:0.4rem 0 0;color:#c2c9c7;">Opisz problem przez telefon - przyjadę obejrzeć za darmo i powiem, co trzeba zrobić.</p>
</div>
<a class="btn-cu" href={`tel:${site.phoneHref}`} style="display:inline-flex;align-items:center;gap:0.7rem;background:#a8521f;color:#ffffff;text-decoration:none;font-weight:600;padding:0.95rem 1.4rem;">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
Zadzwoń: {phoneShort}
</a>
</div>
</div>
</section>

<!-- CALCULATOR -->
<section id="kalkulator" style="background:#0e4650;color:#f3ede3;padding:7rem 0;position:relative;overflow:hidden;">
<svg aria-hidden="true" data-parallax="0.14" width="420" height="420" viewBox="0 0 420 420" style="position:absolute;right:-90px;top:-90px;opacity:0.12;"><g fill="none" stroke="#f3ede3" stroke-width="2"><rect x="0" y="0" width="100" height="100"></rect><rect x="106" y="0" width="100" height="100"></rect><rect x="212" y="0" width="100" height="100"></rect><rect x="318" y="0" width="100" height="100"></rect><rect x="106" y="106" width="100" height="100"></rect><rect x="212" y="106" width="100" height="100"></rect><rect x="318" y="106" width="100" height="100"></rect><rect x="212" y="212" width="100" height="100"></rect><rect x="318" y="212" width="100" height="100"></rect><rect x="318" y="318" width="100" height="100"></rect></g></svg>
<div class="wrap calc-grid" style="position:relative;">
<div>
<p class="mono sec-label" style="color:#e8a27a;margin:0 0 1.4rem;">02 / Kalkulator online</p>
<h2 class="disp" style="font-size:clamp(2.4rem,4.6vw,4.4rem);line-height:1;font-weight:600;margin:0 0 1.8rem;">Ile kosztuje Twój remont? <em style="font-weight:400;color:#e8a27a;">Sprawdź, zanim zadzwonisz.</em></h2>
<p style="font-size:1.15rem;color:#d5dfdc;max-width:32rem;margin:0 0 2.2rem;">Zaznaczasz zakres prac, podajesz metraż i liczbę punktów - dostajesz widełki cenowe z rozbiciem na pozycje, szacowany czas i gotowe zapytanie do wysłania. Bez logowania.</p>
<ul style="list-style:none;margin:0 0 2.6rem;padding:0;border-top:1px solid #2e6670;">
