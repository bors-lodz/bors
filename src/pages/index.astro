---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { servicesByHome, services } from '../data/services';
import { site, hasPhone } from '../config/site';

const phoneHref = hasPhone ? `tel:${site.phoneHref}` : '/kontakt';

const steps = [
  { t: 'Kontakt', d: 'Dzwonisz lub wysyłasz zapytanie. Opisujesz, co chcesz zrobić.' },
  { t: 'Bezpłatne oględziny', d: 'Przyjeżdżamy, mierzymy i doradzamy rozwiązania.' },
  { t: 'Wycena', d: 'Przygotowujemy konkretną, przejrzystą wycenę prac i materiałów.' },
  { t: 'Realizacja', d: 'Umawiamy termin i realizujemy prace solidnie i na czas.' },
];
---
<BaseLayout
  title="Hydraulik i remonty Łódź - instalacje wod-kan, c.o., łazienki | BORS"
  description="BORS - instalacje wodno-kanalizacyjne, c.o. oraz remonty łazienek, glazura i wykończenia w Łodzi i okolicach. Bezpłatne oględziny i wycena. Oblicz koszt remontu online."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-petrol text-stone">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <svg width="100%" height="100%"><defs><pattern id="g" width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="#fff" stroke-width="1.5"/></pattern></defs><rect width="100%" height="100%" fill="url(#g)"/></svg>
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-[1.15fr_1fr] md:py-24">
      <div>
        <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm font-semibold text-copper-light">
          <Icon name="pin" size={16} /> Łódź i okolice
        </p>
        <h1 class="text-4xl leading-[1.08] sm:text-5xl">
          Instalacje wod-kan, c.o. <br class="hidden sm:block" />glazura i remonty łazienek
        </h1>
        <p class="mt-5 max-w-xl text-lg text-stone/85">
          Remontujemy łazienki, wykonujemy instalacje wodno-kanalizacyjne i grzewcze,
          układamy glazurę i terakotę. Solidnie, terminowo, z bezpłatną wyceną.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={phoneHref} class="inline-flex items-center justify-center gap-2 rounded-xl bg-copper px-6 py-3.5 text-base font-bold text-white shadow-lg transition-colors hover:bg-copper-light">
            <Icon name="phone" size={20} /> {hasPhone ? site.phone : 'Zadzwoń do nas'}
          </a>
          <a href="/kalkulator" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/40 bg-white/5 px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-white/15">
            <Icon name="calc" size={20} /> Oblicz koszt remontu
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-stone/80">
          <li class="flex items-center gap-2"><Icon name="check" size={18} class="text-copper-light" /> Bezpłatne oględziny</li>
          <li class="flex items-center gap-2"><Icon name="check" size={18} class="text-copper-light" /> Przejrzysta wycena</li>
          <li class="flex items-center gap-2"><Icon name="check" size={18} class="text-copper-light" /> Solidnie i terminowo</li>
        </ul>
      </div>

      <!-- ilustracja (bez zdjęć realizacji) -->
      <div class="hidden md:block" aria-hidden="true">
        <svg viewBox="0 0 400 360" class="mx-auto w-full max-w-sm drop-shadow-2xl">
          <rect x="20" y="20" width="360" height="320" rx="24" fill="#0A3A43"/>
          <g>
            <rect x="52" y="52" width="130" height="130" rx="10" fill="#F5F3EF"/>
            <rect x="200" y="52" width="130" height="130" rx="10" fill="#F5F3EF"/>
            <rect x="52" y="200" width="130" height="130" rx="10" fill="#F5F3EF"/>
            <rect x="200" y="200" width="130" height="130" rx="10" fill="#C26B35"/>
          </g>
          <g stroke="#10505C" stroke-width="10" fill="none" stroke-linecap="round">
            <path d="M104 150 V96 Q104 84 116 84 H150"/>
          </g>
          <circle cx="265" cy="265" r="26" fill="none" stroke="#F5F3EF" stroke-width="10"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- USŁUGI -->
  <section id="uslugi" class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-wider text-copper">Co robimy</p>
      <h2 class="text-3xl sm:text-4xl">Nasze usługi</h2>
      <p class="mt-3 text-lg text-muted">Od pojedynczej instalacji po kompleksowy remont - wszystko z jedną, sprawdzoną ekipą.</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {servicesByHome.map((s) => (
        <a href={`/uslugi/${s.slug}`} class="group flex flex-col rounded-2xl border border-line bg-white p-6 transition-all hover:-translate-y-1 hover:border-copper/40 hover:shadow-lg">
          <span class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-stone text-petrol transition-colors group-hover:bg-copper group-hover:text-white">
            <Icon name={s.icon} size={26} />
          </span>
          <h3 class="text-lg font-bold">{s.cardTitle}</h3>
          <p class="mt-2 flex-1 text-sm text-muted">{s.cardDesc}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-copper">Zobacz więcej <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" /></span>
        </a>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      Zajmujemy się też <a href="/uslugi/remonty-wykonczenia" class="font-semibold text-copper hover:underline">remontami i wykończeniami</a> (sufity GK, gładzie, malowanie, zabudowy).
    </p>
  </section>

  <!-- KALKULATOR CTA -->
  <section class="bg-stone">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="grid items-center gap-8 rounded-3xl bg-petrol px-6 py-10 text-stone md:grid-cols-[1.4fr_1fr] md:px-12 md:py-14">
        <div>
          <p class="mb-2 font-display text-sm font-bold uppercase tracking-wider text-copper-light">Kalkulator online</p>
          <h2 class="text-3xl text-stone sm:text-4xl">Policz orientacyjny koszt remontu w 2 minuty</h2>
          <p class="mt-4 max-w-xl text-lg text-stone/85">
            Wybierz zakres prac, podaj metraż i od razu zobacz widełki cenowe oraz szacowany czas.
            Bez logowania, bez zobowiązań.
          </p>
          <a href="/kalkulator" class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl bg-copper px-6 py-3.5 text-base font-bold text-white shadow-lg transition-colors hover:bg-copper-light">
            <Icon name="calc" size={20} /> Przejdź do kalkulatora
          </a>
        </div>
        <ul class="space-y-3 md:border-l md:border-white/15 md:pl-10">
          {['Widełki cenowe z rozbiciem na pozycje','Szacowany czas realizacji','Gotowe zapytanie do wysłania'].map((t) => (
            <li class="flex items-start gap-3 text-stone/90"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-copper-light" /> {t}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- JAK PRACUJEMY -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-wider text-copper">Prosto i bez niespodzianek</p>
      <h2 class="text-3xl sm:text-4xl">Jak pracujemy</h2>
    </div>
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="relative rounded-2xl border border-line bg-white p-6">
          <span class="font-display text-4xl font-extrabold text-stone-dark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 text-lg font-bold">{step.t}</h3>
          <p class="mt-2 text-sm text-muted">{step.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- OBSZAR DZIAŁANIA -->
  <section class="bg-stone">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
          <p class="mb-2 font-display text-sm font-bold uppercase tracking-wider text-copper">Gdzie działamy</p>
          <h2 class="text-3xl sm:text-4xl">Łódź i okolice</h2>
          <p class="mt-4 text-lg text-muted">
            Realizujemy zlecenia na terenie całej Łodzi oraz w miejscowościach sąsiednich.
            Dojeżdżamy na bezpłatne oględziny.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {site.areaServed.map((city) => (
              <li class="rounded-full border border-line bg-white px-4 py-1.5 text-sm font-semibold text-ink">{city}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-line bg-white p-8 text-center">
          <Icon name="pin" size={40} class="mx-auto text-copper" />
          <p class="mt-4 font-bold">Łódź i okolice</p>
          <p class="text-muted">Dojazd na terenie miasta i miejscowości sąsiednich</p>
          <a href="/kontakt" class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-copper hover:underline">Dane kontaktowe <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- REALIZACJE (placeholder) -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="mb-2 font-display text-sm font-bold uppercase tracking-wider text-copper">Portfolio</p>
        <h2 class="text-3xl sm:text-4xl">Realizacje</h2>
        <p class="mt-3 text-lg text-muted">Galeria naszych prac. Zdjęcia dodamy wkrótce.</p>
      </div>
      <a href="/realizacje" class="inline-flex items-center gap-1 text-sm font-bold text-copper hover:underline">Zobacz galerię <Icon name="arrow" size={16} /></a>
    </div>
    <!-- DO UZUPEŁNIENIA: prawdziwe zdjęcia realizacji (patrz src/data/realizacje.ts). Poniżej neutralne ilustracje. -->
    <div class="grid gap-5 sm:grid-cols-3">
      {['Łazienki', 'Instalacje', 'Glazura'].map((label, i) => (
        <div class="flex aspect-[4/3] flex-col items-center justify-center rounded-2xl border border-dashed border-line bg-stone text-center">
          <Icon name={(['bath','pipe','tiles'] as const)[i]} size={40} class="text-petrol/40" />
          <p class="mt-3 text-sm font-semibold text-muted">{label}</p>
          <p class="text-xs text-muted/70">zdjęcia wkrótce</p>
        </div>
      ))}
    </div>
  </section>

  <!-- KONTAKT CTA -->
  <section class="bg-petrol-dark">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-16 text-center text-stone md:py-20">
      <h2 class="max-w-2xl text-3xl text-stone sm:text-4xl">Masz pytanie albo chcesz wycenę? Odezwij się.</h2>
      <p class="max-w-xl text-lg text-stone/80">Oględziny i wycena są bezpłatne i do niczego nie zobowiązują.</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={phoneHref} class="inline-flex items-center justify-center gap-2 rounded-xl bg-copper px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-copper-light">
          <Icon name="phone" size={20} /> {hasPhone ? site.phone : 'Zadzwoń do nas'}
        </a>
        <a href="/kontakt" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/40 px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-white/10">
          <Icon name="mail" size={20} /> Formularz kontaktowy
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
