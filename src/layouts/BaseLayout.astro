---
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '../styles/global.css';
import { site, hasPhone } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteGate from '../components/SiteGate.astro';

interface Props {
  title: string;
  description: string;
  /** ścieżka obrazu OG względem domeny, domyślnie /og.png */
  image?: string;
  noindex?: boolean;
  /** dodatkowe obiekty JSON-LD (np. FAQPage, BreadcrumbList) */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/og.png',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href.replace(/\/$/, '') || site.url;
const ogImage = new URL(image, site.url).href;
const fullTitle = title.includes('BORS') ? title : `${title} | BORS Łódź`;

// Dane strukturalne firmy (spójne NAP) - obecne na każdej stronie.
const localBusiness: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['HomeAndConstructionBusiness', 'Plumber'],
  '@id': `${site.url}/#business`,
  name: site.legalName,
  alternateName: site.brand,
  url: site.url,
  image: ogImage,
  taxID: site.nip,
  vatID: `PL${site.nip}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.address.geo.lat,
    longitude: site.address.geo.lng,
  },
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  ...(hasPhone ? { telephone: site.phoneHref } : {}),
};

const allJsonLd = [localBusiness, ...jsonLd];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#10505c" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="BORS" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {allJsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <SiteGate />
    <a href="#tresc" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-petrol focus:px-4 focus:py-2 focus:text-stone">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
  </body>
</html>
